{
  "name": "cli-agent-mode",
  "version": "0.2.0",
  "description": "Make commander.js CLIs agent-friendly for AI coding agents (Claude Code, Codex, Cursor, Gemini CLI, opencode): --json output envelopes, structured errors with suggestions, a describe command with the CLI schema, agent auto-detection, stable exit codes.",
  "keywords": [
    "cli",
    "commander",
    "commander.js",
    "commander-plugin",
    "ai-agents",
    "agent-friendly",
    "llm",
    "llm-friendly",
    "agentic",
    "json",
    "json-output",
    "cli-json",
    "machine-readable",
    "structured-errors",
    "exit-codes",
    "self-describing",
    "cli-schema",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm,cjs && node scripts/postbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "commander": ">=12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "commander": "^15.1.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/missingbits/cli-agent-mode.git"
  },
  "homepage": "https://github.com/missingbits/cli-agent-mode#readme",
  "bugs": {
    "url": "https://github.com/missingbits/cli-agent-mode/issues"
  },
  "author": "Gordey Levchenko (https://github.com/lgordey)",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "allowScripts": {
    "fsevents": false
  }
}
