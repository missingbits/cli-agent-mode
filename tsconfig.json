{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": [
      "node"
    ],
    "paths": {
      "cli-agent-mode": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "types"
  ]
}
